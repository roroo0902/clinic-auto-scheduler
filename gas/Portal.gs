background:#253b50;color:white}#month-wheel-value{text-align:center}\r\n/* Phone layout shared by iOS Safari and Android Chrome. */\r\n#schedule-dialog,#schedule-month-picker{color-scheme:light}#schedule-dialog button,#schedule-dialog select,#schedule-dialog input{touch-action:manipulation}#schedule-dialog .mobile-day-detail{display:none}#schedule-dialog .day{text-align:left;min-width:0}#schedule-dialog .scroll{-webkit-overflow-scrolling:touch;overscroll-behavior-x:contain}#schedule-dialog .table-scroll-hint{margin:8px 0;font-size:14px}#schedule-month-picker{box-sizing:border-box;max-height:calc(100vh - 32px);max-height:calc(100dvh - 32px);overflow:auto}#schedule-month-picker .month-wheel{touch-action:pan-y;-webkit-overflow-scrolling:touch}\r\n@media(max-width:600px){\r\n #schedule-dialog{position:fixed;inset:0;margin:0;width:100%;max-width:100%;height:100vh;height:100dvh;max-height:100vh;max-height:100dvh;border:0;border-radius:0;padding:calc(16px + env(safe-area-inset-top,0px)) calc(12px + env(safe-area-inset-right,0px)) calc(24px + env(safe-area-inset-bottom,0px)) calc(12px + env(safe-area-inset-left,0px));overflow-x:hidden;overscroll-behavior:contain}\r\n #schedule-dialog h2{font-size:22px;line-height:1.5;letter-spacing:.02em;padding-right:48px;margin:8px 0 18px}#schedule-dialog h3{font-size:18px;line-height:1.6}#schedule-dialog p{overflow-wrap:anywhere}\r\n #schedule-dialog>.close{width:44px;height:44px;min-height:44px;right:calc(8px + env(safe-area-inset-right,0px));top:calc(8px + env(safe-area-inset-top,0px));padding:0;font-size:26px}\r\n #schedule-dialog .schedule-navigation{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:10px;margin:12px 0}#schedule-dialog .schedule-navigation>label{grid-column:span 3;min-width:0;font-size:14px}#schedule-dialog .schedule-navigation.single-employee-field>label:first-child{grid-column:1/-1}#schedule-dialog .schedule-navigation #schedule-personal{grid-column:1/span 2}#schedule-dialog .schedule-navigation>button{