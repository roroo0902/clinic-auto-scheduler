 32px);max-width:360px;padding:20px 16px;border-radius:16px;margin:auto}#schedule-month-picker h3{padding:0;font-size:20px}#schedule-month-picker .month-wheel-columns{gap:16px}#schedule-month-picker .month-picker-actions button{min-height:48px;font-size:16px;flex:1}header{gap:10px}#signed-in{max-width:100%!important;width:100%;font-size:12px}main{padding:24px 18px}footer{flex-wrap:wrap}\r\n}\r\n@media(max-height:560px){#schedule-month-picker{padding:12px 16px}#schedule-month-picker .month-wheel{height:120px;padding:40px 0}#schedule-month-picker .wheel-frame:after{top:40px}#schedule-month-picker p{margin:6px 0}}\r\n</style>\r\n<dialog id=\"schedule-dialog\" aria-labelledby=\"schedule-title\"><button class=\"close\" aria-label=\"關閉班表\">×</button><h2 id=\"schedule-title\">班表</h2><div class=\"toolbar schedule-navigation\"><label for=\"schedule-month-trigger\">選擇月份<button type=\"button\" id=\"schedule-month-trigger\" aria-haspopup=\"dialog\">2026 年 11 月 ▾</button><input type=\"hidden\" id=\"schedule-month\" value=\"2026-11\"></label><label id=\"schedule-employee-field\" hidden>查看員工<select id=\"schedule-employee\"></select></label><button id=\"schedule-personal\">我的班表</button><button id=\"schedule-all\">整體班表</button><button id=\"schedule-reload\">重新讀取</button></div><p id=\"schedule-month-help\" class=\"schedule-month-help\">點選月份，開啟「年份／月份」滾輪；上下滑動後按「套用月份」。</p><p id=\"schedule-status\" role=\"status\"></p><div id=\"schedule-content\"></div><div id=\"schedule-edit\" hidden></div><p>A 早班 08:00–12:00 · B 午班 14:30–18:30 · C 晚班 18:30–21:30<br>「未排班」表示當天尚未安排班別，不代表已核准休假；「本月未提供班次」表示原始 PDF 沒有該員工的班表資料。</p><dialog id=\"schedule-month-picker\" aria-labelledby=\"month-picker-title\"><h3 id=\"month-picker-title\">選擇年份與月份</h3><p>上下滑動滾輪，讓要選的年月停在中央。</p><div class=\"month-wheel-columns\"><div><div class=\"wheel-caption\">年份</div><div class=\"wheel-frame\"><div id=\"year-wheel\" class=\"month-wheel\" role=\"listbox\" tabindex=\"0\" aria-label=\"年份滾輪\"></div></div></div><div><div class=\"wheel-caption\">月份</div><div class=\"wheel-frame\"><div id=\"month-wheel\" class=\"month-wheel\" role=\"listbox\" tabindex=\"0\" aria-label=\"月份滾輪\"></div></div></div></div><p id=\"month-wheel-value\" aria-live=\"polite\"></p><div class=\"month-picker-actions\"><button type=\"button\" id=\"month-picker-cancel\">取消</button><button type=\"button\" id=\"month-picker-apply\">套用月份</button></div></dialog></dialog>\r\n<script>\r\nconst scheduleDialog=document.getElementById('schedule-dialog'),scheduleContent=document.getElementById('schedule-content'),scheduleStatus=document.getElementById('schedule-status');\r\nlet scheduleEmployeeId='',scheduleView='personal',scheduleData=null,scheduleSequence=0,scheduleSaving=false;\r\nconst scheduleEl=(tag,text)=>{const e=document.createElement(tag);if(text!==undefined)e.textContent=text;return e;};\r\nfunction scheduleMonthLabel(month){return month.slice(0,4)+' 年 '+Number(month.slice(5))+' 月';}\r\nfunction scheduleRPC(method,arg){return new Promise((resolve,reject)=>{const r=google.script.run.withSuccessHandler(resolve).withFailureHandler(reject);if(method==='read')r.getSchedule(arg);else r.saveScheduleDay(arg);});}\r\nasync function openSchedule(view){scheduleView=view||'personal';if(!scheduleDialog.open)scheduleDialog.showModal();await loadSchedule();}\r\nasync function loadSchedule(){\r\n if(scheduleSaving)return;const sequence=++scheduleSequence;scheduleData=null;scheduleContent.replaceChildren();document.getElementById('schedule-edit').hidden=true;scheduleStatus.textContent='正在確認身分並讀取班表…';\r\n try{const data=await scheduleRPC('read',{month:document.getElementById('schedule-month').value,view:scheduleView,employeeId:scheduleEmployeeId});if(sequence!==scheduleSequence)return;scheduleData=data;renderSchedule(data);}\r\n catch(e){if(sequence===scheduleSequence)scheduleStatus.textContent=e.message||'讀取失敗，請重試。';}\r\n}\r\nfunction renderSchedule(data){\r\n const employeeField=document.getElementById('schedule-employee-field'),employeeSelect=document.getElementById('schedule-employee');employeeField.hidden=!(data.canEdit&&data.view==='personal');employeeField.parentElement.classList.toggle('single-employee-field',employeeField.hidden);employeeSelect.replaceChildren();(data.employeeOptions||[]).forEach(e=>employeeSelect.add(new Option(e.name,e.id)));if(data.view==='personal'){scheduleEmployeeId=data.selectedEmployeeId||'';employeeSelect.value=scheduleEmployeeId;}employeeSelect.disabled=!(data.employeeOptions||[]).length;\r\n\r\n document.getElementById('schedule-month').value=data.month;document.getElementById('schedule-month-trigger').textContent=scheduleMonthLabel(data.month)+' ▾';\r\n document.getElementById('schedule-personal').setAttribute('aria-pressed',String(data.view==='personal'));document.getElementById('schedule-all').setAttribute('aria-pressed',String(data.view==='all'));\r\n document.getElementById('schedule-title').textContent=scheduleMonthLabel(data.month)+' · '+(data.view==='personal'?'我的班表':'整體班表');\r\n const summary=scheduleEl('div');summary.className='schedule-summary';\r\n [['本月上班天數',data.standard?data.standard.workDays+' 天':'待設定或同步'],['預期上班總時數',data.standard?data.standard.hours+' 小時／人':'待設定或同步'],[data.view==='all'?'班表總時數（全體合計）':'班表總時數',data.employees.reduce((n,e)=>n+e.hours,0)+' 小時']].forEach(([label,value])=>{const card=scheduleEl('div');card.append(scheduleEl('span',label),scheduleEl('strong',value));summary.append(card);});scheduleContent.append(summary);\r\n scheduleStatus.textContent=data.employees.length?data.employees.length+' 人 · '+data.employees.reduce((n,e)=>n+e.hours,0)+' 小時':'本月尚無班表資料。';\r\n if(data.view==='personal'&&data.employees.length){const e=data.employees[0];scheduleStatus.textContent=e.name+' · '+e.hours+' 小時 · '+e.workDays+' 個出勤日 · '+e.status;const grid=scheduleEl('div');grid.className='calendar';'日一二三四五六'.split('').forEach(x=>grid.append(scheduleEl('b',x)));const offset=new Date(data.month+'-01T12:00:00').getDay();for(let i=0;i<offset;i++)grid.append(scheduleEl('div'));e.days.forEach((shift,i)=>{const cell=scheduleEl('button');cell.type='button';cell.className='day';cell.setAttribute('aria-label',String(i+1)+' 日，'+(shift||'未排班')+'，點選查看班別時間');cell.onclick=()=>showScheduleDay(data,i,true);cell.append(scheduleEl('strong',String(i+1)),scheduleEl('span',shift||'未排班'));for(const s of shift)cell.append(scheduleEl('small',({A:'08:00–12:00',B:'14:30–18:30',C:'18:30–21:30'})[s]));grid.append(cell);});scheduleContent.append(grid);const detail=scheduleEl('div');detail.id='schedule-day-detail';detail.className='mobile-day-detail';detail.setAttribute('role','status');scheduleContent.append(detail);showScheduleDay(data,0,false);}\r\n else {scheduleContent.append(Object.assign(scheduleEl('p','左右滑動可查看完整日期、工時與資料狀態；姓名會固定在左側。'),{className:'table-scroll-hint'}));const wrap=scheduleEl('div');wrap.className='scroll';const table=scheduleEl('table'),head=scheduleEl('tr');['姓名',...Array.from({length:data.dayCount},(_,i)=>String(i+1)),'已排班天數','預期上班總時數','班表總時數','資料狀態'].forEach(v=>head.append(scheduleEl('th',v)));const thead=scheduleEl('thead'),week=scheduleEl('tr');week.className='weekday-row';week.append(scheduleEl('th','星期'));data.weekdays.forEach(w=>{const cell=scheduleEl('th',w);if(w==='日'||w==='六')cell.className='weekend';week.append(cell);});for(let i=0;i<4;i++)week.append(scheduleEl('th',''));thead.append(head,week);table.append(thead);data.employees.forEach(e=>{const row=scheduleEl('tr');row.append(scheduleEl('td',e.name));e.days.forEach(shift=>{const cell=scheduleEl('td',shift||'—');cell.dataset.shift=shift;row.append(cell);});row.append(scheduleEl('td',e.workDays+' 天'),scheduleEl('td',data.standard?data.standard.hours+' 小時':'待設定或同步'),scheduleEl('td',e.hours+' 小時'),scheduleEl('td',e.status));table.append(row);});wrap.append(table);scheduleContent.append(wrap);}\r\n if(data.canEdit&&data.employees.length)renderScheduleEditor(data);\r\n}\r\nfunction showScheduleDay(data,index,scroll){const detail=document.getElementById('schedule-day-detail');