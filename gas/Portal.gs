dStatus('正在備份、套用與讀回核對，請勿重複操作…');\r\n  try{const r=await wdRpc('apply',{token:result.token,confirmed:true});wdDirty=false;formDirty=false;formDraft=null;formData=r.data;formList();wdBody.replaceChildren(formEl('p','已儲存每週範本，並核對 '+r.changed+' 個班別。'),formButton('返回月曆',()=>wdDialog.close()));wdStatus(r.month+' 套用完成。特殊日期可直接點月曆修改。');}\r\n  catch(e){wdStatus((e.message||'套用未完成')+'\\n請先重新讀取 Sheet 確認結果，不要重複送出。');wdBody.append(formButton('關閉並重新讀取',()=>{wdDirty=false;wdDialog.close();formLoad(formData.name);}));}\r\n  finally{wdBusy=false;}\r\n });save.disabled=true;check.addEventListener('change',()=>save.disabled=!check.checked);bar.append(back,save);wdBody.append(bar);\r\n}\r\n</script>\r\n<style>\r\n#schedule-dialog{box-sizing:border-box;width:min(1200px,96vw);max-width:min(1200px,96vw);max-height:92dvh;overflow:auto;background:#f7f6f2;color:#233346;border:1px solid #b4a078;border-radius:16px;padding:24px}#schedule-dialog h2,#schedule-dialog h3{color:#253b50}#schedule-dialog p{color:#43556a}#schedule-dialog::backdrop{background:#071525cc}#schedule-dialog button,#schedule-dialog input,#schedule-dialog select{font:inherit;padding:10px;border:1px solid #9ba9b5;border-radius:7px;background:white;color:#203247}#schedule-dialog input[type=number]{width:90px}#schedule-dialog input[type=month]{width:160px}#schedule-dialog .toolbar{display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin:16px 0}#schedule-dialog .scroll{overflow:auto;max-height:60vh}#schedule-dialog table{border-collapse:separate;border-spacing:0;width:100%;background:white}#schedule-dialog th,#schedule-dialog td{padding:10px;border-right:1px solid #ddd;border-bottom:1px solid #ddd;white-space:nowrap;text-align:center}#schedule-dialog th{color:#253b50;background:#e8edf1;position:sticky;top:0;z-index:1}#schedule-dialog th:first-child,#schedule-dialog td:first-child{position:sticky;left:0;background:#edf0ee;z-index:2;text-align:left}#schedule-dialog th:first-child{z-index:3}#schedule-dialog td[data-shift]:not([da