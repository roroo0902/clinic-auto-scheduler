}\nfunction cellValue(value){return {userEnteredValue:typeof value==='boolean'?{boolValue:value}:typeof value==='number'?{numberValue:value}:{stringValue:String(value)}};}\nfunction changes(headers,before,after){return headers.flatMap((key,i)=>(before[i]??'')===after[i]?[]:[{key,index:i,before:before[i]??'',after:after[i]}]);}\nfunction updateRequests(sheetId,rowIndex,diff){return diff.map(d=>({updateCells:{start:{sheetId,rowIndex,columnIndex:d.index},rows:[{values:[cellValue(d.after)]}],fields:'userEnteredValue'}}));}\n\nfunction nextEmployeeId(ids){const max=ids.reduce((n,id)=>{const m=/^EMP(\\d+)$/.exec(String(id));return m?Math.max(n,Number(m[1])):n;},0);if(!Number.isSafeInteger(max+1))throw Error('員工代碼超出可用範圍');return 'EMP'+String(max+1).padStart(3,'0');}\n\r\n\nconst formDialog=document.getElementById('web-form'),formBody=document.getElementById('form-body');\nlet formData=null,formBusy=false,formDirty=false,formDraft=null,formGeneration=0;\nconst formEl=(tag,text)=>{const e=document.createElement(tag);if(text!==undefined)e.textContent=text;return e;};\nconst formStatus=t=>document.getElementById('form-status').textContent=t;\nfunction formButton(label,fn){const b=formEl('button',label);b.type='button';b.className='action secondary';b.addEventListener('click',fn);return b;}\nfunction formClose(){if(formBusy)return;if(formDirty&&!confirm('還有未上傳的草稿，確定關閉？'))return;formGeneration++;formDirty=false;formDraft=null;formDialog.close();}\nformDialog.querySelector('.close').addEventListener('click',formClose);formDialog.addEventListener('cancel',e=>{e.preventDefault();formClose();});\nwindow.addEventListener('beforeunload',e=>{if(formDirty||formBusy){e.preventDefault();e.returnValue='';}});\nfunction formRpc(method,arg){return new Promise((resolve,reject)=>{const run=google.script.run.withSuccessHandler(resolve).withFailureHandler(reject);if(method==='getFormData')run.getFormData(arg);else run.saveFormData(arg);});}\nasync function openWebForm(name){\n if(formBusy)return