ndNewShift='A';\r\nconst demandOriginalList=formList,demandOriginalFields=formFields;\r\nfunction demandIsForm(){return formData?.name==='DailyShiftDemands';}\r\nfunction demandValue(record,key){const cell=record?.cells[formData.headers.indexOf(key)];return cell?.value??'';}\r\nfunction demandISO(value){\r\n if(typeof value==='number')return new Date(Date.UTC(1899,11,30)+value*86400000).toISOString().slice(0,10);\r\n const text=String(value||''),date=new Date(text+'T00:00:00Z');return /^\\d{4}-\\d{2}-\\d{2}$/.test(text)&&Number.isFinite(date.getTime())&&date.toISOString().slice(0,10)===text?text:'';\r\n}\r\nfunction demandRows(date,shift){return formData.rows.filter(r=>demandISO(demandValue(r,'date'))===date&&demandValue(r,'shiftId')===shift);}\r\nfunction demandState(rows){\r\n if(rows.length>1)return {label:'重複',css:'demand-pending'};\r\n if(!rows.length)return {label:'未建',css:'demand-pending'};\r\n const r=rows[0],closed=demandValue(r,'isClosed'),min=demandValue(r,'requiredHeadcount'),max=demandValue(r,'MaxStaff'),ideal=demandValue(r,'idealHeadcount');\r\n if(closed===true)return {label:[min,max,ideal].some(v=>v!==''&&Number(v)>0)?'衝突':'休診',css:'demand-closed'};\r\n if(closed!==false||min===''||max==='')return {label:'待填',css:'demand-pending'};\r\n if(![min,max].every(v=>typeof v==='number'&&Number.isInteger(v)&&v>=0)||min>max||ideal!==''&&(!Number.isInteger(ideal)||ideal<min||ideal>max))return {label:'待核對',css:'demand-pending'};\r\n return {label:min+'–'+max,css:'demand-ready'};\r\n}\r\nfunction demandDays(month){const [y,m]=month.split('-').map(Number);return {offset:new Date(Date.UTC(y,m-1,1)).getUTCDay(),count:new Date(Date.UTC(y,m,0)).getUTCDate()};}\r\nfunction demandDiscard(){return !formDirty||confirm('切換會清除尚未儲存的修改，確定切換？');}\r\nformList=function(){\r\n if(!demandIsForm())return demandOriginalList();\r\n const required=['demandId','date','shiftId','requiredHeadcount','MaxStaff','idealHeadcount','isClosed'];\r\n if(required.some(k=>!formData.headers.include