rd=formData?.rows.find(r=>r.row===row),code=record?.cells[0]?.value;\r\n if(!controlIsForm()||!controlSettings[code])return controlOriginalFields(row,draft);\r\n const before=record.cells.map(c=>c.value),value=draft?draft[2]:before[2],holder=document.getElementById('form-fields');holder.replaceChildren();\r\n const form=formEl('form');form.className='control-editor';form.append(formEl('h3',controlSettings[code][0]));\r\n const label=formEl('label');label.append(formEl('span',code==='WEEK_START_DAY'?'選擇星期':'重視程度'));\r\n const input=formEl('select');input.id='control-value';input.append(new Option('尚未設定',''));\r\n (code==='WEEK_START_DAY'?[1,2,3,4,5,6,7]:[0,1,2,3]).forEach(v=>input.append(new Option(controlDisplay(code,v),String(v))));\r\n if(value!==''&&![...input.options].some(o=>o.value===String(value)))input.append(new Option(controlDisplay(code,value),String(value)));\r\n input.value=String(value);input.disabled=!!record.cells[2].formula;input.addEventListener('change',()=>formDirty=true);label.append(input);form.append(label);\r\n const hint=formEl('p',controlSettings[code][1]);hint.className='hint';form.append(hint);\r\n const details=formEl('details');details.append(formEl('summary','查看設定說明'),formEl('p',String(before[3]||'')),formEl('small',code));form.append(details);\r\n const bar=formEl('div');bar.className='bar';const preview=formEl('button','預覽變更');preview.className='action';preview.type='submit';bar.append(preview);form.append(bar);formDirty=!!draft;\r\n form.addEventListener('submit',e=>{e.preventDefault();const values=before.slice();values[2]=input.disabled||input.value===String(before[2])?before[2]:input.value===''?'':Number(input.value);try{validateRecord(formData.headers,values,formData.name);formPreview(row,before,values);}catch(err){formStatus(err.message);}});holder.append(form);\r\n};\r\n</script>\r\n<style>\r\n#web-form:has(.demand-calendar){width:min(1000px,94vw);max-width:94vw;box-sizing:border-box}#web-form .demand-toolbar{display:flex;gap:8