rent=()=>{preview.replaceChildren();const e=data.employees.find(x=>x.id===person.value),n=selectedDay();if(!Number.isInteger(n)||n<1||n>data.dayCount){current.textContent='請選擇本月份內的日期。';return;}shift.value=e.days[n-1];current.textContent=e.name+' · '+day.value+' · 目前班別：'+(e.days[n-1]?labels[e.days[n-1]]:'未排班');};\r\n person.onchange=()=>{if(data.view==='personal'){scheduleEmployeeId=person.value;loadSchedule();}else showCurrent();};day.onchange=showCurrent;shift.onchange=()=>preview.replaceChildren();showCurrent();\r\n form.addEventListener('submit',event=>{event.preventDefault();preview.replaceChildren();const e=data.employees.find(x=>x.id===person.value),n=selectedDay();if(!Number.isInteger(n)||n<1||n>data.dayCount)return;const input={month:data.month,employeeId:e.id,day:n,before:e.days[n-1],shift:shift.value};\r\n preview.append(scheduleEl('p','尚未儲存：'+e.name+' · '+day.value+'，將由「'+(input.before?labels[input.before]:'未排班')+'」改為「'+labels[input.shift]+'」。'));\r\n const confirm=scheduleEl('button','確認儲存班別');confirm.type='button';preview.append(confirm);\r\n confirm.addEventListener('click',async()=>{if(scheduleSaving)return;scheduleSaving=true;[person,day,shift,confirm,submit].forEach(c=>c.disabled=true);scheduleStatus.textContent='正在儲存並核對班別…';try{await scheduleRPC('write',input);scheduleSaving=false;await loadSchedule();scheduleStatus.textContent+=' · 班別已儲存並核對';}catch(error){scheduleStatus.textContent=error.message||'儲存失敗';}finally{scheduleSaving=false;[person,day,shift,confirm,submit].forEach(c=>c.disabled=false);}});\r\n });\r\n}\r\ndocument.getElementById('schedule-personal').onclick=()=>openSchedule('personal');document.getElementById('schedule-all').onclick=()=>openSchedule('all');document.getElementById('schedule-reload').onclick=loadSchedule;document.getElementById('schedule-month').onchange=()=>{scheduleEmployeeId='';loadSchedule();};document.getElementById('schedule-employee').onchange=event=>{if(scheduleSaving)return;scheduleEmployeeId=event.target.value;loadSchedule();};\r\nconst monthPicker=document.getElementById('schedule-month-picker');\r\nlet monthWheelYear=2026,monthWheelMonth=11;\r\nfunction buildMonthWheel(id,values,selected,suffix,onSelect){\r\n const wheel=document.getElementById(id);wheel.replaceChildren();\r\n values.forEach(value=>{const option=scheduleEl('div',value+suffix);option.className='wheel-option';option.id=id+'-'+value;option.setAttribute('role','option');option.setAttribute('aria-selected',String(value===selected));option.onclick=()=>wheel.scrollTo({top:values.indexOf(value)*40,behavior:'smooth'});wheel.append(option);});\r\n const update=()=>{const index=Math.max(0,Math.min(values.length-1,Math.round(wheel.scrollTop/40)));Array.from(wheel.children).forEach((e,i)=>e.setAttribute('aria-selected',String(i===index)));wheel.setAttribute('aria-activedescendant',id+'-'+values[index]);onSelect(values[index]);document.getElementById('month-wheel-value').textContent=monthWheelYear+' 年 '+monthWheelMonth+' 月';};\r\n wheel.onscroll=update;wheel.onkeydown=event=>{if(!['ArrowUp','ArrowDown','Home','End'].includes(event.key))return;event.preventDefault();const current=Math.round(wheel.scrollTop/40),index=event.key==='Home'?0:event.key==='End'?values.length-1:current+(event.key==='ArrowUp'?-1:1);wheel.scrollTo({top:Math.max(0,Math.min(values.length-1,index))*40,behavior:'auto'});update();};wheel.scrollTop=values.indexOf(selected)*40;update();\r\n}\r\ndocument.getElementById('schedule-month-trigger').onclick=()=>{if(scheduleSaving)return;const parts=document.getElementById('schedule-month').value.split('-').map(Number);monthWheelYear=parts[0];monthWheelMonth=parts[1];monthPicker.showModal();buildMonthWheel('year-wheel',Array.from({length:21},(_,i)=>parts[0]-10+i),parts[0],' 年',v=>monthWheelYear=v);buildMonthWheel('month-wheel',Array.from({length:12},(_,i)=>i+1),parts[1],' 月',v=>monthWheelMonth=v);};\r\ndocument.getElementById('month-picker-cancel').onclick=()=>monthPicker.close();monthPicker.addEventListener('