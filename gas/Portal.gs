tton type=\"button\" id=\"month-picker-apply\">套用月份</button></div></dialog></dialog>\n<script>\nconst scheduleDialog=document.getElementById('schedule-dialog'),scheduleContent=document.getElementById('schedule-content'),scheduleStatus=document.getElementById('schedule-status');\nlet scheduleEmployeeId='',scheduleView='personal',scheduleData=null,scheduleSequence=0,scheduleSaving=false;\nconst scheduleEl=(tag,text)=>{const e=document.createElement(tag);if(text!==undefined)e.textContent=text;return e;};\nfunction scheduleMonthLabel(month){return month.slice(0,4)+' 年 '+Number(month.slice(5))+' 月';}\nfunction scheduleRPC(method,arg){return new Promise((resolve,reject)=>{const r=google.script.run.withSuccessHandler(resolve).withFailureHandler(reject);if(method==='read')r.getSchedule(arg);else r.saveScheduleDay(arg);});}\nasync function openSchedule(view){scheduleView=view||'personal';if(!scheduleDialog.open)scheduleDialog.showModal();await loadSchedule();}\nasync function loadSchedule(){\n if(scheduleSaving)return;const sequence=++scheduleSequence;scheduleData=null;scheduleContent.replaceChildren();document.getElementById('schedule-edit').hidden=true;scheduleStatus.textContent='正在確認身分並讀取班表…';\n try{const data=await scheduleRPC('read',{month:document.getElementById('schedule-month').value,view:scheduleView,employeeId:scheduleEmployeeId});if(sequence!==scheduleSequence)return;scheduleData=data;renderSchedule(data);}\n catch(e){if(sequence===scheduleSequence)scheduleStatus.textContent=e.message||'讀取失敗，請重試。';}\n}\nfunction renderSchedule(data){\n const employeeField=document.getElementById('schedule-employee-field'),employeeSelect=document.getElementById('schedule-employee');employeeField.hidden=!(data.canEdit&&data.view==='personal');employeeField.parentElement.classList.toggle('single-employee-field',employeeField.hidden);employeeSelect.replaceChildren();(data.employeeOptions||[]).forEach(e=>employeeSelect.add(new Option(e.name,e.id)));if(data.view==='personal'){scheduleEmployeeId=data.selectedEmployeeId||'';employeeSelect.value=scheduleEmployeeId;}employeeSelect.disabled=!(data.employeeOptions||[]).length;\n\n document.getElementById('schedule-month').value=data.month;document.getElementById('schedule-month-trigger').textContent=scheduleMonthLabel(data.month)+' ▾';\n document.getElementById('schedule-personal').setAttribute('aria-pressed',String(data.view==='personal'));document.getElementById('schedule-all').setAttribute('aria-pressed',String(data.view==='all'));\n document.getElementById('schedule-title').textContent=scheduleMonthLabel(data.month)+' · '+(data.view==='personal'?'我的班表':'整體班表');\n const summary=scheduleEl('div');summary.className='schedule-summary';\n [['本月上班天數',data.standard?data.standard.workDays+' 天':'待設定或同步'],['預期上班總時數',data.standard?data.standard.hours+' 小時／人':'待設定或同步'],[data.view==='all'?'班表總時數（全體合計）':'班表總時數',data.employees.reduce((n,e)=>n+e.hours,0)+' 小時']].forEach(([label,value])=>{const card=scheduleEl('div');card.append(scheduleEl('span',label),scheduleEl('strong',value));summary.append(card);});scheduleContent.append(summary);\n scheduleStatus.textContent=data.employees.length?data.employees.length+' 人 · '+data.employees.reduce((n,e)=>n+e.hours,0)+' 小時':'本月尚無班表資料。';\n if(data.view==='personal'&&data.employees.length){const e=data.employees[0];scheduleStatus.textContent=e.name+' · '+e.hours+' 小時 · '+e.workDays+' 個出勤日 · '+e.status;const grid=scheduleEl('div');grid.className='calendar';'日一二三四五六'.split('').forEach(x=>grid.append(scheduleEl('b',x)));const offset=new Date(data.month+'-01T12:00:00').getDay();for(let i=0;i<offset;i++)grid.append(scheduleEl('div'));e.days.forEach((shift,i)=>{const cell=scheduleEl('button');cell.type='button';cell.className='day';cell.setAttribute('aria-label',String(i+1)+' 日，'+(shift||'未排班')+'，點選查看班別時間');cell.onclick=()=>showScheduleDay(data,i,true);cell.append(scheduleEl('strong',String(i+1)),scheduleEl('span',shift||'未排班'));for(const s of shift)cell.append(scheduleEl('small',({A:'08:00–12:00',B:'14:30–18:30',C:'18:30–21:30'})[s]));grid.append(cell);});scheduleContent.append(grid);const detail=scheduleEl('div');detail.id='schedule-day-detail';detail.className='mobile-day-detail';detail.setAttribute('role','status');scheduleContent.append(detail);showScheduleDay(data,0,false);}\n else {scheduleContent.append(Object.assign(scheduleEl('p','左右滑動可查看完整日期、工時與資料狀態；姓名會固定在左側。'),{className:'table-scroll-hint'}));const wrap=scheduleEl('div');wrap.className='scroll';const table=scheduleEl('table'),head=scheduleEl('tr');['姓名',...Array.from({length:data.dayCount},(_,i)=>String(i+1)),'已排班天數','預期上班總時數','班表總時數','資料狀態'].forEach(v=>head.append(scheduleEl('th',v)));const thead=scheduleEl('thead'),week=scheduleEl('tr');week.className='weekday-row';week.append(scheduleEl('th','星期'));data.weekdays.forEach(w=>{const cell=scheduleEl('th',w);if(w==='日'||w==='六')cell.className='weekend';week.append(cell);});for(let i=0;i<4;i++)week.append(scheduleEl('th',''));thead.append(head,week);table.append(thead);data.employees.forEach(e=>{const row=scheduleEl('tr');row.append(scheduleEl('td',e.name));e.days.forEach(shift=>{const cell=scheduleEl('td',shift||'—');cell.dataset.shift=shift;row.append(cell);});row.append(scheduleEl('td',e.workDays+' 天'),scheduleEl('td',data.standard?data.standard.hours+' 小時':'待設定或同步'),scheduleEl('td',e.hours+' 小時'),scheduleEl('td',e.status));table.append(row);});wrap.append(table);scheduleContent.append(wrap);}\n if(data.canEdit&&data.employees.length)renderScheduleEditor(data);\n}\nfunction showScheduleDay(data,index,scroll){const detail=document.getElementById('schedule-day-detail');if(!detail)return;const shift=data.employees[0].days[index];detail.textContent=Number(data.month.slice(5))+' 月 '+(index+1)+' 日（星期'+data.weekdays[index]+'）'+(shift?'':' 未排班')+(shift?'\\n'+[...shift].map(s=>({A:'A 早班 08:00–12:00',B:'B 午班 14:30–18:30',C:'C 晚班 18:30–21:30'})[s]).join('\\n'):'')+'\\n點選月曆日期可查看當日班別時間。';if(scroll&&matchMedia('(max-width:600px)').matches)detail.scrollIntoView({block:'nearest',behavior:'smooth'});}\nfunction renderScheduleEditor(data){\n const box=document.getElementById('schedule-edit');box.hidden=false;box.replaceChildren(scheduleEl('h3','管理者專用：新增或修改員工班別'));\n box.append(scheduleEl('p','① 選擇員工與日期　② 選擇要安排的班別　③ 預覽後確認儲存。'));\n const form=scheduleEl('form');form.className='toolbar';form.style.alignItems='flex-end';\n const person=scheduleEl('select'),day=scheduleEl('input'),shift=scheduleEl('select'),submit=scheduleEl('button','預覽班別變更');\n const field=(title,control)=>{const label=scheduleEl('label',title);label.style.display='flex';label.style.flexDirection='column';label.style.gap='7px';label.append(control);return label;};\n day.type='date';day.min=data.month+'-01';day.max=data.month+'-'+String(data.dayCount).padStart(2,'0');day.value=day.min;day.required=true;\n (data.view==='personal'?data.employeeOptions:data.employees).forEach(e=>person.add(new Option(e.name,e.id)));if(data.view==='personal')person.value=data.selectedEmployeeId;\n const labels={'':'未排班（清除當日班別）',A:'A 早班｜08:00–12:00',B:'B 午班｜14:30–18:30',C:'C 晚班｜18:30–21:30',AB:'AB 早班＋午班',AC:'AC 早班＋晚班',BC:'BC 午班＋晚班',ABC:'ABC 早班＋午班＋晚班'};\n Object.keys(labels).forEach(s=>shift.add(new Option(labels[s],s)));submit.type='submit';\n form.append(field('員工姓名',person),field('日期（年／月／日）',day),field('當日班別',shift),submit);box.append(form);\n const current=scheduleEl('p'),preview=scheduleEl('div');preview.setAttribute('aria-live','polite');box.append(current,preview);\n const selectedDay=()=>day.value.startsWith(data.month+'-')?Number(day.value.slice(8)):NaN;\n const showCurrent=()=>{preview.replaceChildren();const e=data.employees.find(x=>x.id===person.value),n=selectedDay();if(!Number.isInteger(n)||n<1||n>data.dayCount){current.textContent='請選擇本月份內的日期。';return;}shift.value=e.days[n-1];current.textContent=e.name+' · '+day.value+' · 目前班別：'+(e.days[n-1]?labels[e.days[n-1]]:'未排班');};\n person.onchange=()=>{if(data.view==='personal'){scheduleEmployeeId=person.value;loadSchedule();}else showCurrent();};day.onchange=showCurrent;shift.onchange=()=>preview.replaceChildren();showCurrent();\n form.addEventListener('submit',event=>{event.preventDefault();preview.replaceChildren();const e=data.employees.find(x=>x.id===person.value),n=selectedDay();if(!Number.isInteger(n)||n<1||n>data.dayCount)return;const input={month:data.month,employeeId:e.id,day:n,before:e.days[n-1],shift:shift.value};\n preview.append(scheduleEl('p','尚未儲存：'+e.name+' · '+day.value+'，將由「'+(input.before?labels[input.before]:'未排班')+'」改為「'+labels[input.shift]+'」。'));\n const confirm=scheduleEl('button','確認儲存班別');confirm.type='button';preview.append(confirm);\n confirm.addEventListener('click',async()=>{if(scheduleSaving)return;scheduleSaving=true;[person,day,shift,confirm,submit].forEach(c=>c.disabled=true);scheduleStatus.textContent='正在儲存並核對班別…';try{await scheduleRPC('write',input);scheduleSaving=false;await loadSchedule();scheduleStatus.textContent+=' · 班別已儲存並核對';}catch(error){scheduleStatus.textContent=error.message||'儲存失敗';}finally{scheduleSaving=false;[person,day,shift,confirm,submit].forEach(c=>c.disabled=false);}});\n });\n}\ndocument.getElementById('schedule-personal').onclick=()=>openSchedule('personal');document.getElementById('schedule-all').onclick=()=>openSchedule('all');document.getElementById('schedule-reload').onclick=loadSchedule;document.getElementById('schedule-month').onchange=()=>{scheduleEmployeeId='';loadSchedule();};document.getElementById('schedule-employee').onchange=event=>{if(scheduleSaving)return;scheduleEmployeeId=event.target.value;loadSchedule();};\nconst monthPicker=document.getElementById('schedule-month-picker');\nlet monthWheelYear=2026,monthWheelMonth=11;\nfunction buildMonthWheel(id,values,selected,suffix,onSelect){\n const wheel=document.getElementById(id);wheel.replaceChildren();\n values.forEach(value=>{const option=scheduleEl('div',value+suffix);option.className='wheel-option';option.id=id+'-'+value;option.setAttribute('role','option');option.setAttribute('aria-selected',String(value===selected));option.onclick=()=>wheel.scrollTo({top:values.indexOf(value)*40,behavior:'smooth'});wheel.append(option);});\n const update=()=>{const index=Math.max(0,Math.min(values.length-1,Math.round(wheel.scrollTop/40)));Array.from(wheel.children).forEach((e,i)=>e.setAttribute('aria-selected',String(i===index)));wheel.setAttribute('aria-activedescendant',id+'-'+values[index]);onSelect(values[index]);document.getElementById('month-wheel-value').textContent=monthWheelYear+' 年 '+monthWheelMonth+' 月';};\n wheel.onscroll=update;wheel.onkeydown=event=>{if(!['ArrowUp','ArrowDown','Home','End'].includes(event.key))return;event.preventDefault();const current=Math.round(wheel.scrollTop/40),index=event.key==='Home'?0:event.key==='End'?values.length-1:current+(event.key==='ArrowUp'?-1:1);wheel.scrollTo({top:Math.max(0,Math.min(values.length-1,index))*40,behavior:'auto'});update();};wheel.scrollTop=values.indexOf(selected)*40;update();\n}\ndocument.getElementById('schedule-month-trigger').onclick=()=>{if(scheduleSaving)return;const parts=document.getElementById('schedule-month').value.split('-').map(Number);monthWheelYear=parts[0];monthWheelMonth=parts[1];monthPicker.showModal();buildMonthWheel('year-wheel',Array.from({length:21},(_,i)=>parts[0]-10+i),parts[0],' 年',v=>monthWheelYear=v);buildMonthWheel('month-wheel',Array.from({length:12},(_,i)=>i+1),parts[1],' 月',v=>monthWheelMonth=v);};\ndocument.getElementById('month-picker-cancel').onclick=()=>monthPicker.close();monthPicker.addEventListener('cancel',e=>e.stopPropagation());\ndocument.getElementById('month-picker-apply').onclick=()=>{const value=monthWheelYear+'-'+String(monthWheelMonth).padStart(2,'0');monthPicker.close();document.getElementById('schedule-month').value=value;document.getElementById('schedule-month-trigger').textContent=scheduleMonthLabel(value)+' ▾';scheduleEmployeeId='';loadSchedule();};\nscheduleDialog.querySelector('.close').onclick=()=>{if(!scheduleSaving){scheduleSequence++;scheduleDialog.close();}};scheduleDialog.addEventListener('cancel',e=>{if(scheduleSaving)e.preventDefault();else scheduleSequence++;});\ndocument.querySelectorAll('[data-schedule]').forEach(b=>b.onclick=()=>openSchedule(b.dataset.schedule));\n</script>\n</body></html>\n";
