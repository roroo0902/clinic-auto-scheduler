set.boolean==='true'?c.value==='true':c.type==='number'?Number(c.value):parseInput(data.headers[i],c.value));\n  validateRecord(data.headers,values,data.name);formPreview(row,before,values);\n }catch(err){formStatus(err.message);}});holder.append(form);\n}\nfunction formPreview(row,before,values){\n const diffs=changes(formData.headers,row<0?formData.headers.map(()=>''):before,values);if(!diffs.length){formStatus('沒有變更需要上傳。');return;}\n formDirty=true;formDraft={row,values};const holder=document.getElementById('form-fields');holder.replaceChildren(formEl('h3','確認寫入內容'),formEl('p',formData.title+' · '+(row<0?'新增資料':'修改第 '+(row+1)+' 列')));\n holder.append(formTable(['欄位','原本','修改後'],diffs.map(d=>[labels[d.key]||d.key,String(d.before),String(d.after)])));\n const check=formEl('input');check.type='checkbox';const label=formEl('label');label.append(check,document.createTextNode('我已核對內容，確認寫入 Google Sheets。'));holder.append(label);\n const bar=formEl('div');bar.className='bar';const save=formButton('確認並寫入試算表',()=>formSave(row,values));save.disabled=true;check.addEventListener('change',()=>save.disabled=!check.checked);bar.append(formButton('返回修改',()=>formFields(row,values)),save);holder.append(bar);formStatus('尚未寫入試算表。請確認上方差異。');\n}\nasync function formSave(row,values){\n if(formBusy)return;formBusy=true;formDialog.querySelectorAll('button,input,select').forEach(e=>e.disabled=true);formStatus('正在檢查最新資料並寫入，請勿關閉…');\n try{const result=await formRpc('saveFormData',{name:formData.name,row,values,fingerprint:formData.fingerprint});formDirty=false;formDraft=null;await formLoad(formData.name);formStatus('已成功寫入第 '+result.row+' 列，並從 Google Sheets 讀回確認。');}\n catch(e){formStatus((e.message||'儲存失敗')+'\\n請先重新讀取確認結果，不要直接重複送出。草稿仍保留。');const bar=formEl('div');bar.className='bar';bar.append(formButton('返回草稿',()=>formFields(row,values)),formButton('確認後重新讀取',()=>{if(confirm('重新讀取會清除草稿。請先記下修改內容。'))formLoad(formData.name);}));document.getElementById('form-fields').append(bar);}\n finally{formBusy=false;formDialog.querySelector('.close').disabled=false;}\n}\n</script>\n</body></html>\n";

